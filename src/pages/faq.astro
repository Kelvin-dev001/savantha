---
/**
 * /faq: every question in one place, grouped like the hub. "Working with us" (the general
 * questions from home.yaml) first, then each pillar as a register: the pillar name holds
 * in a sticky column while its services' questions scroll beside it. The hero's index
 * jumps to each group. Answers live with their services, so this page can never drift
 * from the service pages. FAQPage JSON-LD carries every question and answer.
 */
import { getEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/sections/PageHero.astro';
import NextSteps from '@/components/sections/NextSteps.astro';
import FaqList from '@/components/ui/FaqList.astro';
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import { getPillars, getServices } from '@/lib/services';
import { whatsappLink } from '@/lib/contact';

const pages = (await getEntry('pages', 'pages'))!.data;
const q = pages.faq;
const home = (await getEntry('home', 'home'))!.data;
const [pillars, services] = await Promise.all([getPillars(), getServices()]);
const bySlug = new Map(services.map((s) => [s.data.slug, s.data]));

const count = (n: number) =>
  `${String(n).padStart(2, '0')} ${n === 1 ? q.countLabel.one : q.countLabel.many}`;
const general = home.faq.items;

const index = [
  { href: `#${q.general.key}`, numeral: '—', title: q.general.title, n: general.length },
  ...pillars.map((p) => ({
    href: `#${p.key}`,
    numeral: p.numeral,
    title: p.title,
    n: p.services.reduce((sum, s) => sum + (bySlug.get(s.slug)?.faqs.length ?? 0), 0),
  })),
];

const all = [...general, ...services.flatMap((s) => s.data.faqs)];
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: all.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---

<BaseLayout title={q.seoTitle} description={q.seoDescription}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />
  <PageHero eyebrow={q.eyebrow} headline={q.headline} lead={q.lead} size="page">
    <Fragment slot="aside">
      <nav class="fidx" aria-labelledby="fidx-label">
        <h2 id="fidx-label" class="eyebrow fidx__label">
          {q.indexLabel}
        </h2>
        <ol class="fidx__list">
          {index.map((g) => (
            <li>
              <a href={g.href} class="fidx__link">
                <span class="fidx__num eyebrow numerals" aria-hidden="true">
                  {g.numeral}
                </span>
                <span class="fidx__name">{g.title}</span>
                <span class="fidx__count eyebrow numerals">{count(g.n)}</span>
                <Icon name="arrow-right" size={14} class="fidx__arrow" />
              </a>
            </li>
          ))}
        </ol>
      </nav>
    </Fragment>
    <Fragment slot="foot">
      <NextSteps />
    </Fragment>
  </PageHero>

  <section id={q.general.key} class="freg shell" aria-labelledby={`${q.general.key}-title`}>
    <div class="freg__side">
      <div class="freg__sticky">
        <p class="eyebrow freg__eyebrow">{count(general.length)}</p>
        <h2 id={`${q.general.key}-title`} class="freg__title">
          {q.general.title}
        </h2>
        <p class="freg__line">{q.general.line}</p>
      </div>
    </div>
    <div class="freg__main">
      <FaqList items={general} name="faq-general" />
    </div>
  </section>

  {pillars.map((p) => (
    <section id={p.key} class="freg shell" aria-labelledby={`${p.key}-title`}>
      <div class="freg__side">
        <div class="freg__sticky">
          <p class="eyebrow numerals freg__eyebrow">
            {p.numeral} <span aria-hidden="true">—</span>{' '}
            {count(index.find((g) => g.href === `#${p.key}`)!.n)}
          </p>
          <h2 id={`${p.key}-title`} class="freg__title">
            {p.title}
          </h2>
          <p class="freg__line">{p.line}</p>
        </div>
      </div>
      <div class="freg__main">
        {p.services.map((s) => (
          <div class="fsvc">
            <div class="fsvc__head">
              <h3 class="fsvc__title">{s.title}</h3>
              <Button href={s.href} variant="text" class="fsvc__link">
                {q.serviceLink}
                <span class="sr-only">: {s.title}</span>
              </Button>
            </div>
            <FaqList items={bySlug.get(s.slug)!.faqs} name={`faq-${s.slug}`} openFirst={false} />
          </div>
        ))}
      </div>
    </section>
  ))}

  <section class="fmore shell" aria-labelledby="fmore-title">
    <h2 id="fmore-title" class="fmore__title" data-reveal="mask">
      {q.more.heading}
    </h2>
    <div class="fmore__side">
      <p class="fmore__body">{q.more.body}</p>
      <div class="fmore__actions">
        <span class="magnetic" data-magnetic>
          <Button
            href={whatsappLink(undefined, q.more.whatsappMessage)}
            size="lg"
            icon="whatsapp"
            data-track="whatsapp_click"
            data-track-service="general"
            data-track-location="faq-more"
          >
            {q.more.cta}
          </Button>
        </span>
        <Button href={q.more.link.href} variant="text">
          {q.more.link.label}
        </Button>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Layered so Tailwind utilities on the same element still win. */
  @layer components {
    /* ---------- hero index ---------- */
    .fidx__label {
      color: var(--color-stone);
      padding-bottom: 1rem;
    }
    .fidx__list {
      border-top: 1px solid var(--color-ink);
    }
    .fidx__link {
      display: grid;
      grid-template-columns: 2rem minmax(0, 1fr) auto 1rem;
      gap: 0 0.75rem;
      align-items: baseline;
      min-height: 52px;
      padding-block: 0.875rem;
      border-bottom: 1px solid var(--color-line);
      transition: color 240ms var(--ease-quiet);
    }
    .fidx__link:hover {
      color: var(--color-royal);
    }
    .fidx__num,
    .fidx__count {
      color: var(--color-stone);
    }
    .fidx__name {
      font-family: var(--font-display);
      font-size: 1.25rem;
      font-weight: 400;
    }
    .fidx__link :global(.fidx__arrow) {
      align-self: center;
      transition: transform 420ms var(--ease-settle);
    }
    .fidx__link:hover :global(.fidx__arrow) {
      transform: translateX(3px);
    }

    /* ---------- registers ---------- */
    .freg {
      display: grid;
      gap: 2rem var(--gap-x);
      padding-top: var(--section-y);
    }
    .freg + .freg {
      padding-top: clamp(4rem, 3rem + 4vw, 7rem);
    }
    @media (min-width: 1024px) {
      .freg {
        grid-template-columns: repeat(12, minmax(0, 1fr));
        align-items: start;
      }
      .freg__side {
        grid-column: 1 / span 4;
        align-self: stretch;
      }
      .freg__sticky {
        position: sticky;
        top: calc(var(--header-h) + 2rem);
      }
      .freg__main {
        grid-column: 5 / span 8;
      }
    }
    .freg__side {
      border-top: 1px solid var(--color-ink);
      padding-top: 1.25rem;
    }
    .freg__eyebrow {
      color: var(--color-stone);
    }
    .freg__title {
      margin-top: 0.75rem;
      font-size: var(--text-d1);
      line-height: var(--text-d1--line-height);
      letter-spacing: var(--text-d1--letter-spacing);
      font-weight: 320;
      font-variation-settings: 'opsz' 144;
    }
    .freg__line {
      margin-top: 1rem;
      color: var(--color-stone);
      font-size: var(--text-small);
      line-height: var(--text-small--line-height);
      max-width: 32ch;
    }
    .fsvc + .fsvc {
      margin-top: clamp(3rem, 2rem + 3vw, 4.5rem);
    }
    .fsvc__head {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      justify-content: space-between;
      gap: 0.25rem 1.5rem;
      padding-bottom: 1rem;
    }
    .fsvc__title {
      font-size: var(--text-d3);
      line-height: var(--text-d3--line-height);
      letter-spacing: var(--text-d3--letter-spacing);
      font-weight: 380;
    }
    .fsvc__head :global(.fsvc__link) {
      font-size: var(--text-small);
    }

    /* ---------- not answered ---------- */
    .fmore {
      display: grid;
      gap: 1.5rem var(--gap-x);
      margin-top: var(--section-y);
      margin-bottom: var(--section-y);
      padding-top: clamp(2rem, 1.5rem + 2vw, 3.5rem);
      border-top: 1px solid var(--color-ink);
    }
    @media (min-width: 1024px) {
      .fmore {
        grid-template-columns: repeat(12, minmax(0, 1fr));
        align-items: start;
      }
      .fmore__title {
        grid-column: 1 / span 5;
      }
      .fmore__side {
        grid-column: 6 / span 6;
      }
    }
    .fmore__title {
      font-size: var(--text-d2);
      line-height: var(--text-d2--line-height);
      letter-spacing: var(--text-d2--letter-spacing);
      font-weight: 340;
    }
    .fmore__body {
      color: var(--color-stone);
      max-width: 48ch;
    }
    .fmore__actions {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.75rem 2rem;
      margin-top: 1.75rem;
    }
    @media (max-width: 639.98px) {
      .fmore__actions > .magnetic,
      .fmore__actions > .magnetic :global(.btn) {
        width: 100%;
      }
    }
  }
</style>
