<script>
  document.querySelectorAll<HTMLButtonElement>('[data-replay]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const fig = btn.closest('[data-replay-target]');
      const svg = fig?.querySelector('.lattice svg');
      if (!svg) return;
      const fresh = svg.cloneNode(true);
      svg.replaceWith(fresh);
    });
  });
</script>
