---
/**
 * /styleguide — internal design-system reference (noindex). Phase 2 adds 07 Motion.
 * Colours and contrast ratios are computed from global.css at build time.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionLabel from '@/components/ui/SectionLabel.astro';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import Button from '@/components/ui/Button.astro';
import Lattice from '@/components/ui/Lattice.astro';
import Monogram from '@/components/ui/Monogram.astro';
import Ph from '@/components/ui/Ph.astro';
import PlaceholderImage from '@/components/ui/PlaceholderImage.astro';
import { site } from '@/config/site';
import { whatsappLink } from '@/lib/contact';
import { readColorTokens, contrast, over, toHex } from '@/lib/tokens';

const tokens = readColorTokens();
const t = Object.fromEntries(tokens.map((x) => [x.name, x]));

const roles: Record<string, string> = {
  ink: 'Base. Dark sections, body text on light.',
  'ink-800': 'Raised surfaces on ink.',
  'ink-700': 'Hover on ink, image vignettes.',
  royal: 'Links, focus, interactive states.',
  gold: 'Rules, icons, large numerals. Never body text on ivory.',
  'gold-soft': 'Labels and accents on ink.',
  ivory: 'Reading surface. The default page.',
  paper: 'Lifted panels on ivory.',
  stone: 'Secondary text on ivory and paper.',
  line: 'Ledger hairlines. Gold at 28%.',
};

type Pair = {
  fg: string;
  bg: string;
  fgAlpha?: number;
  use: string;
  large?: boolean;
  ui?: boolean;
};
const pairs: Pair[] = [
  { fg: 'ink', bg: 'ivory', use: 'Body text, headings' },
  { fg: 'ink', bg: 'paper', use: 'Body text on panels' },
  { fg: 'stone', bg: 'ivory', use: 'Secondary text' },
  { fg: 'stone', bg: 'paper', use: 'Secondary text on panels' },
  { fg: 'royal', bg: 'ivory', use: 'Links, focus ring' },
  { fg: 'ivory', bg: 'ink', use: 'Text on ink' },
  { fg: 'ivory', bg: 'ink', fgAlpha: 0.72, use: 'Secondary text on ink' },
  { fg: 'gold-soft', bg: 'ink', use: 'Labels, focus ring on ink' },
  { fg: 'gold', bg: 'ink', use: 'Accents, numerals on ink' },
  { fg: 'ivory', bg: 'royal', use: 'Text on royal' },
  { fg: 'royal', bg: 'ink', use: 'Not for focus on ink', ui: true },
  { fg: 'gold', bg: 'ivory', use: 'Rules, icons, numerals ≥ 32 px bold only', large: true },
];
const rows = pairs.map((p) => {
  const fg = t[p.fg];
  const bg = t[p.bg];
  const fgRgb = p.fgAlpha ? over(fg.rgb, p.fgAlpha, bg.rgb) : fg.rgb;
  const ratio = contrast(fgRgb, bg.rgb);
  return {
    ...p,
    label: `${p.fg}${p.fgAlpha ? ` ${Math.round(p.fgAlpha * 100)}%` : ''} on ${p.bg}`,
    fgHex: toHex(fgRgb),
    ratio,
    aa: ratio >= 4.5,
    aaLarge: ratio >= 3,
    aaa: ratio >= 7,
  };
});

const typeScale = [
  {
    token: 'text-hero',
    cls: 'text-hero display',
    family: 'Newsreader',
    spec: '44 → 100 px · 380 · −0.025em · 1.03',
    sample: 'Clarity for your money.',
  },
  {
    token: 'text-d1',
    cls: 'text-d1 display',
    family: 'Newsreader',
    spec: '36 → 72 px · 380 · −0.02em · 1.05',
    sample: site.tagline,
  },
  {
    token: 'text-d2',
    cls: 'text-d2 display',
    family: 'Newsreader',
    spec: '30 → 52 px · 380 · −0.015em · 1.08',
    sample: 'We explain every fee, product and risk in writing.',
  },
  {
    token: 'text-d3',
    cls: 'text-d3 display',
    family: 'Newsreader',
    spec: '24 → 34 px · 380 · −0.01em · 1.15',
    sample: 'How Shariah-compliant finance works in Kenya',
  },
  {
    token: 'text-d4',
    cls: 'text-d4 display',
    family: 'Newsreader',
    spec: '20 → 24 px · 380 · 1.25',
    sample: 'Letters of credit explained for Kenyan importers',
  },
  {
    token: 'text-lead',
    cls: 'text-lead',
    family: 'Inter',
    spec: '19 → 23 px · 400 · 1.5',
    sample:
      'From a first household budget to the structure your children inherit, we help you understand the risks before you commit.',
  },
  {
    token: 'text-body',
    cls: 'text-body measure',
    family: 'Inter',
    spec: '17 → 18 px · 400 · 1.6 · 68ch',
    sample:
      'Every engagement starts with a conversation, not a product. We listen first, then analyse where you are, structure a plan you can follow, and review it with you as life changes. You will always know what we charge, and why.',
  },
  {
    token: 'text-small',
    cls: 'text-small text-muted',
    family: 'Inter',
    spec: '15 px · 400 · 1.55',
    sample: 'We reply within one business day. The first call is free and lasts twenty minutes.',
  },
  {
    token: 'eyebrow',
    cls: 'eyebrow',
    family: 'Inter',
    spec: '12 px · 650 · +0.14em · uppercase',
    sample: '01 — How we work',
  },
];

const sections = [
  {
    n: '01',
    id: 'colour',
    title: 'Colour',
    note: 'Ten tokens and their contrast, computed from source.',
  },
  { n: '02', id: 'type', title: 'Typography', note: 'Newsreader and Inter on one fluid scale.' },
  { n: '03', id: 'controls', title: 'Buttons & links', note: 'Three variants on two surfaces.' },
  { n: '04', id: 'lattice', title: 'The lattice', note: 'The signature motif and its settings.' },
  {
    n: '05',
    id: 'ledger',
    title: 'Rules & ledger rows',
    note: 'The statement-like structure of every page.',
  },
  {
    n: '06',
    id: 'placeholders',
    title: 'Placeholders',
    note: 'How missing client assets are shown.',
  },
  { n: '07', id: 'motion', title: 'Motion', note: 'What moves, when, and for whom.' },
];

const primitives = [
  {
    attr: 'data-reveal="mask"',
    use: 'Headings',
    spec: 'Lines rise out of a mask · 1.1 s · expo out · 80 ms per line',
  },
  { attr: 'data-reveal="fade"', use: 'Body copy', spec: 'Opacity only · 1.0 s · no drift' },
  {
    attr: 'data-reveal="rule"',
    use: 'Hairlines',
    spec: 'Draws left to right like a ledger rule · 1.4 s',
  },
  { attr: 'data-reveal="stagger"', use: 'Lists, rows', spec: 'Children in sequence · 60 ms apart' },
  {
    attr: 'data-parallax="24"',
    use: 'Images, cards',
    spec: 'Drifts up to 24 px while in view · scrubbed',
  },
  {
    attr: 'data-magnetic',
    use: 'The primary CTA',
    spec: 'Leans ≤ 6 px toward the cursor · fine pointers only',
  },
];

const heroTimeline = [
  { t: '0', what: 'Lattice line-draws outward from the seal', dur: '1.6 s' },
  { t: '280', what: 'Seal rings draw, monogram rises', dur: '1.3 s' },
  { t: '520', what: 'Headline rises word by word, 60 ms apart', dur: '1.0 s each' },
  { t: '1050', what: 'Lead fades in', dur: '0.9 s' },
  { t: '1180', what: 'Calls to action', dur: '0.9 s' },
  { t: '1280', what: '“What happens next” ledger', dur: '0.7 s' },
];

const fmt = (r: number) => r.toFixed(2);
---

<BaseLayout
  title="Styleguide"
  description="The Savantho design system: colour, type, controls and the lattice."
  noindex
>
  <!-- Cover -->
  <section
    class="shell pt-[clamp(3rem,2rem+4vw,6rem)] pb-[var(--section-y)]"
    aria-labelledby="sg-title"
  >
    <div class="grid-12 items-end gap-y-14">
      <div class="col-span-12 lg:col-span-7">
        <SectionLabel number="00">Styleguide</SectionLabel>
        <h1 id="sg-title" class="text-hero display mt-[clamp(2.5rem,1.5rem+4vw,5rem)]">
          A system for <em class="sg-em">quiet</em> confidence.
        </h1>
        <p class="text-lead text-muted measure mt-8">
          The working rules behind the new savantho.net. Every colour, size and line on this page
          comes from one set of tokens, so a change made once is made everywhere.
        </p>
        <dl class="sg-meta mt-12">
          <div>
            <dt class="eyebrow text-muted">Version</dt>
            <dd class="numerals">0.2</dd>
          </div>
          <div>
            <dt class="eyebrow text-muted">Phase</dt>
            <dd>2 · Motion</dd>
          </div>
          <div>
            <dt class="eyebrow text-muted">Updated</dt>
            <dd class="numerals">25 Nov 2026</dd>
          </div>
          <div>
            <dt class="eyebrow text-muted">Built with</dt>
            <dd>Astro 5 · Tailwind 4</dd>
          </div>
        </dl>
      </div>
      <div class="col-span-12 lg:col-span-5">
        <figure class="sg-plate surface-ink">
          <Lattice animate density="regular" opacity={0.42} origin={[50, 46]} fade="edges" detail />
          <div class="relative flex h-full flex-col items-center justify-center gap-6 text-center">
            <Monogram size={96} />
            <p class="display text-d4">{site.shortName}</p>
          </div>
          <figcaption class="eyebrow sg-plate__cap">{site.tagline}</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- Contents -->
  <nav aria-label="Styleguide contents" class="shell pb-[var(--section-y)]">
    <ol class="sg-index">
      {sections.map((s) => (
        <li>
          <a href={`#${s.id}`} class="sg-index__row">
            <span class="eyebrow numerals text-muted">{s.n}</span>
            <span class="text-d3 display">{s.title}</span>
            <span class="text-small text-muted hidden md:block">{s.note}</span>
            <span class="sg-index__arrow" aria-hidden="true">
              →
            </span>
          </a>
        </li>
      ))}
    </ol>
  </nav>

  <!-- 01 Colour -->
  <section id="colour" class="sg-section surface-paper" aria-labelledby="colour-h">
    <div class="shell">
      <SectionLabel number="01">Colour</SectionLabel>
      <div class="grid-12 mt-12 gap-y-6">
        <h2 id="colour-h" class="text-d1 display col-span-12 lg:col-span-6">
          One palette, held to account.
        </h2>
        <p class="text-muted col-span-12 lg:col-span-5 lg:col-start-8 lg:self-end">
          Ink carries the weight, ivory gives room to read, and gold is spent like money: on rules,
          icons and the occasional large numeral. It never covers more than about 8% of a screen.
        </p>
      </div>

      <!-- Proportion -->
      <figure class="mt-16">
        <div
          class="sg-proportion"
          role="img"
          aria-label="Intended share of a typical screen: ivory and paper about 62%, ink about 28%, stone and royal about 4%, gold 8% at most."
        >
          <span style="flex: 62; background: var(--color-ivory)"></span>
          <span style="flex: 28; background: var(--color-ink)"></span>
          <span style="flex: 4; background: var(--color-stone)"></span>
          <span style="flex: 2; background: var(--color-royal)"></span>
          <span style="flex: 4; background: var(--color-gold)"></span>
        </div>
        <figcaption class="sg-proportion__legend text-small text-muted numerals mt-4">
          <span>Ivory & paper ~62%</span>
          <span>Ink ~28%</span>
          <span>Stone ~4%</span>
          <span>Royal ~2%</span>
          <span>Gold ≤ 8%</span>
        </figcaption>
      </figure>

      <!-- Swatches -->
      <ul class="sg-swatches mt-16">
        {tokens.map((c) => (
          <li class={`sg-swatch sg-swatch--${c.name}`}>
            <span class="sg-swatch__chip" style={`background: var(--color-${c.name})`} />
            <span class="sg-swatch__meta">
              <span class="text-d4 display">{c.name.replace('-', ' ')}</span>
              <span class="text-small numerals">
                <code>--color-{c.name}</code>
                <span class="text-muted"> · {c.value.toUpperCase().replace('RGB', 'rgb')}</span>
              </span>
              <span class="text-small text-muted">{roles[c.name] ?? c.comment}</span>
            </span>
          </li>
        ))}
      </ul>

      <!-- Contrast ledger -->
      <div class="mt-24">
        <h3 class="text-d3 display">Contrast ledger</h3>
        <p class="text-muted measure mt-3">
          WCAG 2.2 AA asks for 4.5:1 for body text and 3:1 for large text, icons and focus rings.
          Ratios below are computed from the token values at build time.
        </p>
        <table class="sg-table mt-10">
          <caption class="sr-only">Colour pairings and their WCAG contrast ratios</caption>
          <thead>
            <tr>
              <th scope="col" class="eyebrow">
                Pairing
              </th>
              <th scope="col" class="eyebrow">
                Sample
              </th>
              <th scope="col" class="eyebrow text-right">
                Ratio
              </th>
              <th scope="col" class="eyebrow">
                Text AA
              </th>
              <th scope="col" class="eyebrow">
                Large / UI
              </th>
              <th scope="col" class="eyebrow">
                Use
              </th>
            </tr>
          </thead>
          <tbody>
            {rows.map((row) => (
              <tr>
                <th scope="row" class="font-semibold">
                  {row.label}
                </th>
                <td data-label="Sample">
                  <span
                    class="sg-sample"
                    aria-hidden="true"
                    style={`color: ${row.fgAlpha ? `color-mix(in srgb, var(--color-${row.fg}) ${row.fgAlpha * 100}%, transparent)` : `var(--color-${row.fg})`}; background: var(--color-${row.bg});`}
                  ></span>
                </td>
                <td data-label="Ratio" class="numerals text-right font-semibold">
                  {fmt(row.ratio)}:1
                </td>
                <td data-label="Text AA">
                  <span class:list={['sg-verdict', row.aa ? 'is-pass' : 'is-fail']}>
                    {row.aa ? (row.aaa ? 'Pass · AAA' : 'Pass') : 'Fail'}
                  </span>
                </td>
                <td data-label="Large / UI">
                  <span class:list={['sg-verdict', row.aaLarge ? 'is-pass' : 'is-fail']}>
                    {row.aaLarge ? 'Pass' : 'Fail'}
                  </span>
                </td>
                <td data-label="Use" class="text-muted">
                  {row.use}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- 02 Type -->
  <section id="type" class="sg-section" aria-labelledby="type-h">
    <div class="shell">
      <SectionLabel number="02">Typography</SectionLabel>
      <div class="grid-12 mt-12 gap-y-6">
        <h2 id="type-h" class="text-d1 display col-span-12 lg:col-span-7">
          Two voices. One scale.
        </h2>
        <p class="text-muted col-span-12 lg:col-span-4 lg:col-start-9 lg:self-end">
          Newsreader speaks for the firm: considered, editorial, exact. Inter does the work: clear
          at 15 px on a phone in the sun. Sizes are fluid between 360 and 1440 px.
        </p>
      </div>

      <div class="sg-faces mt-16">
        <div class="sg-face">
          <span class="sg-face__glyph display" aria-hidden="true">
            Aa<em>g</em>
          </span>
          <div>
            <p class="text-d4 display">Newsreader</p>
            <p class="text-small text-muted">
              Display · variable, weight 250–500, optical size 48 · roman & italic
            </p>
          </div>
        </div>
        <div class="sg-face">
          <span class="sg-face__glyph sg-face__glyph--sans" aria-hidden="true">
            Aa
          </span>
          <div>
            <p class="text-d4 display">Inter</p>
            <p class="text-small text-muted">Body & interface · variable, weight 300–700</p>
          </div>
        </div>
        <div class="sg-face">
          <span class="sg-face__glyph sg-face__glyph--sans numerals" aria-hidden="true">
            0123
          </span>
          <div>
            <p class="text-d4 display">Figures</p>
            <p class="text-small text-muted">
              Tabular lining numerals for every list, date and table
            </p>
          </div>
        </div>
      </div>

      <ol class="sg-scale mt-20">
        {typeScale.map((s) => (
          <li class="sg-scale__row">
            <div class="sg-scale__meta">
              <code class="text-small font-semibold">{s.token}</code>
              <span class="text-small text-muted">{s.family}</span>
              <span class="text-small text-muted numerals">{s.spec}</span>
            </div>
            <p class={s.cls}>{s.sample}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 03 Controls -->
  <section id="controls" class="sg-section surface-paper" aria-labelledby="controls-h">
    <div class="shell">
      <SectionLabel number="03">Buttons & links</SectionLabel>
      <div class="grid-12 mt-12 gap-y-6">
        <h2 id="controls-h" class="text-d1 display col-span-12 lg:col-span-7">
          Few controls, each with a job.
        </h2>
        <p class="text-muted col-span-12 lg:col-span-4 lg:col-start-9 lg:self-end">
          One primary action per view, usually WhatsApp. Radius 2 px. Targets 44 px and up. A gold
          hairline draws in on hover; focus is a 2 px royal ring, or gold-soft on ink.
        </p>
      </div>

      <div class="sg-controls mt-16">
        <div class="sg-controls__panel surface-ivory">
          <Eyebrow>On ivory</Eyebrow>
          <div class="sg-controls__row">
            <Button href={whatsappLink()} icon="whatsapp">
              Book a free discovery call
            </Button>
            <Button href="/services" variant="secondary">
              Explore services
            </Button>
          </div>
          <div class="sg-controls__row">
            <Button href="/services" variant="text">
              All services
            </Button>
            <Button size="sm">Small</Button>
            <Button size="lg" icon="arrow-right">
              Large
            </Button>
          </div>
          <div class="sg-controls__row">
            <span class="sg-focus-demo">
              <Button variant="secondary" tabindex="-1">
                Focus state
              </Button>
            </span>
            <Button variant="secondary" disabled>
              Disabled
            </Button>
          </div>
          <p class="text-body measure">
            Inline links look like{' '}
            <a class="link" href="/about">
              this, in royal with a gold underline
            </a>
            , and sit comfortably inside a sentence.
          </p>
        </div>
        <div class="sg-controls__panel surface-ink">
          <Lattice density="sparse" opacity={0.12} fade="right" />
          <Eyebrow class="relative">On ink</Eyebrow>
          <div class="sg-controls__row relative">
            <Button href={whatsappLink()} icon="whatsapp" tone="dark">
              Book a free discovery call
            </Button>
            <Button href="/services" variant="secondary" tone="dark">
              Explore services
            </Button>
          </div>
          <div class="sg-controls__row relative">
            <Button href="/services" variant="text" tone="dark">
              All services
            </Button>
            <span class="sg-focus-demo sg-focus-demo--dark">
              <Button variant="secondary" tone="dark" tabindex="-1">
                Focus state
              </Button>
            </span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 04 Lattice -->
  <section id="lattice" class="sg-section" aria-labelledby="lattice-h">
    <div class="shell">
      <SectionLabel number="04">The lattice</SectionLabel>
      <div class="grid-12 mt-12 gap-y-6">
        <h2 id="lattice-h" class="text-d1 display col-span-12 lg:col-span-6">
          Structure, not ornament.
        </h2>
        <p class="text-muted col-span-12 lg:col-span-5 lg:col-start-8 lg:self-end">
          A star-and-cross tessellation built from the eight-point star of Islamic geometry, a
          pattern long familiar along the Kenyan coast. It works like the ruling on a ledger page:
          always there, never loud. One-pixel lines, low opacity, decorative only.
        </p>
      </div>

      <figure class="sg-lattice-hero surface-ink mt-16" data-replay-target>
        <Lattice animate density="regular" opacity={0.5} origin={[18, 40]} fade="left" />
        <figcaption class="relative flex h-full flex-col justify-between p-[clamp(1.5rem,1rem+2vw,3rem)]">
          <Eyebrow as="span" class="relative">
            animate · origin [18, 40] · fade "left"
          </Eyebrow>
          <span class="flex flex-wrap items-end justify-between gap-6">
            <span class="text-d2 display max-w-[16ch]">Line-draws once on load, about 1.6 s.</span>
            <Button variant="secondary" tone="dark" size="sm" data-replay>
              Replay the draw
            </Button>
          </span>
        </figcaption>
      </figure>

      <ul class="sg-lattice-grid mt-6">
        <li class="sg-lattice-card surface-ink">
          <Lattice density="sparse" opacity={0.3} />
          <span class="sg-lattice-card__label">density="sparse" · 168 px</span>
        </li>
        <li class="sg-lattice-card surface-ink">
          <Lattice density="regular" opacity={0.3} />
          <span class="sg-lattice-card__label">density="regular" · 112 px</span>
        </li>
        <li class="sg-lattice-card surface-ink">
          <Lattice density="dense" opacity={0.3} detail />
          <span class="sg-lattice-card__label">density="dense" · detail</span>
        </li>
        <li class="sg-lattice-card">
          <Lattice density="regular" opacity={0.18} fade="radial" />
          <span class="sg-lattice-card__label sg-lattice-card__label--light">
            On ivory · 0.18 · radial
          </span>
        </li>
        <li class="sg-lattice-card">
          <Lattice density="regular" opacity={0.3} tone="ink" fade="edges" />
          <span class="sg-lattice-card__label sg-lattice-card__label--light">
            tone="ink" · 0.30 · edges
          </span>
        </li>
        <li class="sg-lattice-card surface-ink">
          <Lattice density="regular" opacity={0.22} tone="gold-soft" fade="top" />
          <span class="sg-lattice-card__label">tone="gold-soft" · top</span>
        </li>
      </ul>

      <div class="grid-12 mt-16 gap-y-10">
        <div class="col-span-12 md:col-span-6">
          <Eyebrow>Use it</Eyebrow>
          <ul class="sg-rules mt-4">
            <li>Hero (draws once), section dividers, the footer, the Shariah page watermark.</li>
            <li>Opacity 0.08–0.30 on ivory, up to 0.50 on ink where nothing sits on top.</li>
            <li>Fade it out toward where people read.</li>
          </ul>
        </div>
        <div class="col-span-12 md:col-span-6">
          <Eyebrow>Never</Eyebrow>
          <ul class="sg-rules sg-rules--never mt-4">
            <li>Behind running body text at full strength.</li>
            <li>As a filled shape, an icon, or a religious emblem.</li>
            <li>Looping, spinning, or reacting to the cursor.</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- 05 Ledger -->
  <section id="ledger" class="sg-section surface-paper" aria-labelledby="ledger-h">
    <div class="shell">
      <SectionLabel number="05">Rules & ledger rows</SectionLabel>
      <div class="grid-12 mt-12 gap-y-6">
        <h2 id="ledger-h" class="text-d1 display col-span-12 lg:col-span-7">
          Pages that read like a well-kept statement.
        </h2>
        <p class="text-muted col-span-12 lg:col-span-4 lg:col-start-9 lg:self-end">
          Numbered sections, gold hairlines and tabular rows replace cards and shadows. The
