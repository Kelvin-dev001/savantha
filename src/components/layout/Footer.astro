---
import { getEntry, render } from 'astro:content';
import { site, type SocialKey } from '@/config/site';
import { companyLinks, legalLinks, ui } from '@/config/navigation';
import { getPillars } from '@/lib/services';
import { whatsappLink, telLink, mailLink } from '@/lib/contact';
import Monogram from '@/components/ui/Monogram.astro';
import Lattice from '@/components/ui/Lattice.astro';
import Ph from '@/components/ui/Ph.astro';

const disclaimer = await getEntry('legal', 'disclaimer');
if (!disclaimer) throw new Error('src/content/legal/disclaimer.md is required (compliance).');
const { Content: Disclaimer } = await render(disclaimer);
const pillars = await getPillars();
const consent = (await getEntry('pages', 'pages'))!.data.consent;

const socialLabels: Record<SocialKey, string> = {
  linkedin: 'LinkedIn',
  instagram: 'Instagram',
  facebook: 'Facebook',
  x: 'X',
  youtube: 'YouTube',
  tiktok: 'TikTok',
};
const socials = (Object.entries(site.socials) as [SocialKey, string | undefined][]).filter(
  (entry): entry is [SocialKey, string] => Boolean(entry[1]),
);
const year = new Date().getFullYear();
const ph = (v: string) => /\[\[.+?\]\]/.test(v);
---

<footer class="site-footer surface-ink relative isolate overflow-hidden">
  <Lattice density="sparse" opacity={0.16} fade="bottom" class="-z-10" />

  <div class="shell pt-[clamp(4.5rem,3rem+5vw,8rem)] pb-10">
    <div class="grid-12 gap-y-14">
      <div class="col-span-12 lg:col-span-5">
        <a href="/" class="inline-flex items-center gap-3">
          <Monogram size={40} tone="gold" />
          <span class="footer-word">{site.shortName}</span>
          <span class="sr-only">{ui.homeLinkSuffix}</span>
        </a>
        <p class="display text-d2 mt-10 max-w-[14ch]">{site.tagline}</p>
        <p class="text-muted mt-6 max-w-[42ch]">{site.positioning}</p>
      </div>

      <nav
        aria-label={ui.footerNavLabel}
        class="col-span-12 grid grid-cols-2 gap-x-[var(--gap-x)] gap-y-12 sm:grid-cols-3 lg:col-span-7"
      >
        <div>
          <h2 class="eyebrow footer-head">{ui.footerPillars}</h2>
          <ul class="mt-5 space-y-5">
            {pillars.map((p) => (
              <li>
                <a href={`/services#${p.key}`} class="footer-link footer-link--pillar">
                  {p.title}
                </a>
                <ul class="mt-1.5">
                  {p.services.map((s) => (
                    <li>
                      <a href={s.href} class="footer-link text-small text-muted">
                        {s.title}
                      </a>
                    </li>
                  ))}
                </ul>
              </li>
            ))}
          </ul>
        </div>
        <div>
          <h2 class="eyebrow footer-head">{ui.footerCompany}</h2>
          <ul class="mt-5">
            {companyLinks.map((l) => (
              <li>
                <a href={l.href} class="footer-link">
                  {l.label}
                </a>
              </li>
            ))}
          </ul>
          <h2 class="eyebrow footer-head mt-10">{ui.footerLegal}</h2>
          <ul class="mt-5">
            {legalLinks.map((l) => (
              <li>
                <a href={l.href} class="footer-link">
                  {l.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
        <div class="col-span-2 sm:col-span-1">
          <h2 class="eyebrow footer-head">{ui.footerContact}</h2>
          <ul class="mt-5">
            <li>
              <a
                href={whatsappLink()}
                class="footer-link"
                target="_blank"
                rel="noopener noreferrer"
                data-track="whatsapp_click"
                data-track-service="general"
                data-track-location="footer"
              >
                {ui.whatsappLabel}
                <span class="sr-only"> (opens in a new tab)</span>
              </a>
            </li>
            <li>
              <a
                href={telLink()}
                class="footer-link numerals"
                data-track="call_click"
                data-track-location="footer"
              >
                {site.phone.display}
              </a>
            </li>
            <li>
              <a
                href={mailLink()}
                class="footer-link"
                data-track="email_click"
                data-track-location="footer"
              >
                {site.email}
              </a>
            </li>
          </ul>
          <address class="text-small text-muted mt-6 not-italic">
            {site.address.lines.map((l) => (ph(l) ? <Ph>{l}</Ph> : <span>{l}</span>))}
            <br />
            {ph(site.address.city) ? <Ph>{site.address.city}</Ph> : site.address.city},{' '}
            {site.address.country}
          </address>
          <dl class="text-small text-muted mt-4 space-y-1">
            {site.hours.map((h) => (
              <div>
                <dt class="inline">{h.days}: </dt>
                <dd class="numerals inline">{ph(h.time) ? <Ph>{h.time}</Ph> : h.time}</dd>
              </div>
            ))}
          </dl>
          {socials.length > 0 && (
            <ul class="mt-6 flex flex-wrap gap-x-5">
              {socials.map(([key, href]) => (
                <li>
                  <a href={href} class="footer-link" target="_blank" rel="noopener noreferrer">
                    {socialLabels[key]}
                  </a>
                </li>
              ))}
            </ul>
          )}
        </div>
      </nav>
    </div>

    <div class="footer-ledger mt-20">
      <div class="footer-disclaimer text-small text-muted max-w-[96ch]">
        <Disclaimer />
      </div>
      <div class="text-small text-muted mt-8 flex flex-col gap-2 border-t border-[var(--color-line)] pt-6 sm:flex-row sm:items-center sm:justify-between">
        <p class="numerals">
          © {year} {site.legalName}. {ui.rights}
        </p>
        <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:gap-8">
          <p class="numerals">
            {ui.registration}:{' '}
            {ph(site.registration) ? <Ph>{site.registration}</Ph> : site.registration}
          </p>
          <!-- Shown by the analytics script, only when a provider is configured. -->
          <button type="button" class="footer-link footer-prefs" data-consent-open hidden>
            {consent.footerLink}
          </button>
        </div>
      </div>
    </div>
  </div>
</footer>

<style>
  /* Layered so Tailwind utilities on the same element still win. */
  @layer components {
    .footer-word {
      text-transform: uppercase;
      font-family: var(--font-display);
      font-variation-settings: 'opsz' 24;
      font-weight: 480;
      font-size: 1.125rem;
      letter-spacing: 0.28em;
    }
    .footer-head {
      color: var(--color-gold-soft);
    }
    .footer-link {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
      text-decoration: underline;
      text-decoration-color: transparent;
      text-underline-offset: 5px;
      text-decoration-thickness: 1px;
      transition:
        text-decoration-color 280ms var(--ease-quiet),
        color 280ms var(--ease-quiet);
    }
    .footer-link:hover {
      color: var(--color-ivory);
      text-decoration-color: var(--color-gold);
    }
    @media (min-width: 768px) {
      .footer-link {
        min-height: 32px;
      }
    }
    .footer-prefs {
      cursor: pointer;
      text-align: start;
    }
    .footer-prefs[hidden] {
      display: none;
    }
    .footer-link--pillar {
      font-family: var(--font-display);
      font-size: 1.25rem;
      font-weight: 400;
    }
    .footer-ledger {
      border-top: 1px solid var(--color-gold);
      padding-top: 2rem;
      position: relative;
    }
    /* Double rule, like the total line of a statement */
    .footer-ledger::before {
      content: '';
      position: absolute;
      left: 0;
      right: 0;
      top: 3px;
      height: 1px;
      background: var(--color-line);
    }
  }
</style>
