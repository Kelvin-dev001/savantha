---
/**
 * Answer-first FAQ list. Native <details>/<summary> (no JS), grouped with `name` so one
 * opens at a time where supported. The first answer is open on load. The marker is a fine
 * plus whose vertical stroke turns away as the answer opens.
 */
interface Props {
  items: { q: string; a: string }[];
  /** Open the first answer on load (default true). */
  openFirst?: boolean;
  /** Exclusive-accordion group name; unique per list on a page. */
  name: string;
  class?: string;
}
const { items, name, openFirst = true, class: className = '' } = Astro.props;
---

<div class:list={['faql', className]} data-reveal="stagger">
  {items.map((item, i) => (
    <details class="faql__item" name={name} open={openFirst && i === 0}>
      <summary class="faql__q">
        <span class="faql__num numerals" aria-hidden="true">
          {String(i + 1).padStart(2, '0')}
        </span>
        <span class="faql__q-text">{item.q}</span>
        <span class="faql__mark" aria-hidden="true" />
      </summary>
      <div class="faql__a">
        <p>{item.a}</p>
      </div>
    </details>
  ))}
</div>

<style>
  /* Layered so Tailwind utilities on the same element still win. */
  @layer components {
    .faql {
      border-top: 1px solid var(--color-ink);
    }
    .faql__item {
      border-bottom: 1px solid var(--color-line);
    }
    .faql__q {
      display: grid;
      grid-template-columns: 2.5rem minmax(0, 1fr) 1.5rem;
      gap: 0 1rem;
      align-items: baseline;
      padding-block: 1.5rem;
      cursor: pointer;
      list-style: none;
      font-family: var(--font-display);
      font-size: var(--text-d4);
      line-height: var(--text-d4--line-height);
      font-weight: 400;
      transition: color 280ms var(--ease-quiet);
    }
    .faql__q::-webkit-details-marker {
      display: none;
    }
    .faql__q:hover {
      color: var(--color-royal);
    }
    .faql__num {
      font-family: var(--font-sans);
      font-size: var(--text-micro);
      letter-spacing: var(--text-micro--letter-spacing);
      font-weight: 650;
      color: var(--color-stone);
      translate: 0 -0.15em;
    }

    /* Plus → minus */
    .faql__mark {
      position: relative;
      align-self: center;
      width: 14px;
      height: 14px;
      justify-self: end;
    }
    .faql__mark::before,
    .faql__mark::after {
      content: '';
      position: absolute;
      inset: 50% 0 auto 0;
      height: 1px;
      background: var(--color-ink);
      transition: transform 480ms var(--ease-settle);
    }
    .faql__mark::after {
      transform: rotate(90deg);
    }
    .faql__item[open] .faql__mark::after {
      transform: rotate(0deg) scaleX(0);
    }

    .faql__a {
      padding: 0 0 1.75rem calc(2.5rem + 1rem);
      color: var(--color-stone);
      max-width: calc(60ch + 3.5rem);
    }
    .faql__item[open] .faql__a {
      animation: faql-open 520ms var(--ease-quiet);
    }
    @keyframes faql-open {
      from {
        opacity: 0;
      }
    }
    @media (max-width: 639.98px) {
      .faql__q {
        grid-template-columns: minmax(0, 1fr) 1.5rem;
      }
      .faql__num {
        display: none;
      }
      .faql__a {
        padding-inline-start: 0;
      }
    }
  }
</style>
