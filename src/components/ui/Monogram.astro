---
/**
 * PLACEHOLDER monogram until Savantho supplies vectors (see PLACEHOLDERS.md).
 * Eight-point star frame from the lattice, with an italic Fraunces "S".
 */
interface Props {
  size?: number;
  class?: string;
  /** Accessible name. Omit when the monogram sits next to the wordmark. */
  label?: string;
  tone?: 'gold' | 'ink' | 'ivory';
  /** Star stroke in viewBox units (100). Thinner reads finer at large sizes. */
  strokeWidth?: number;
}
const { size = 32, class: className = '', label, tone = 'gold', strokeWidth = 2.4 } = Astro.props;
const stroke = { gold: 'var(--color-gold)', ink: 'var(--color-ink)', ivory: 'var(--color-ivory)' }[
  tone
];

const c = 50;
const R = 48;
const inner = R * (Math.SQRT1_2 / Math.cos(Math.PI / 8));
const pts: string[] = [];
for (let i = 0; i < 16; i++) {
  const a = (i * Math.PI) / 8 - Math.PI / 2;
  const rad = i % 2 === 0 ? R : inner;
  pts.push(`${(c + rad * Math.cos(a)).toFixed(2)} ${(c + rad * Math.sin(a)).toFixed(2)}`);
}
const d = `M${pts.join('L')}Z`;
---

<svg
  class:list={['monogram shrink-0', className]}
  width={size}
  height={size}
  viewBox="0 0 100 100"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
  data-placeholder="true"
>
  <path d={d} fill="none" stroke={stroke} stroke-width={strokeWidth} stroke-linejoin="miter"></path>
  <!-- prettier-ignore -->
  <text x="50" y="51" text-anchor="middle" dominant-baseline="central" fill="currentColor" style="font-family: var(--font-display); font-style: italic; font-size: 46px; font-weight: 420; font-variation-settings: 'opsz' 72;">S</text>
</svg>
