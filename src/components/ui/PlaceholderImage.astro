---
/**
 * Generated image placeholder: ink ground, fine lattice, gold caption.
 * Explicit width/height keep the aspect ratio stable (no CLS).
 * Replace with astro:assets <Image> once real photography exists (see PLACEHOLDERS.md).
 */
interface Props {
  width: number;
  height: number;
  /** Art-direction note shown on the image, e.g. "Mombasa Old Town door, warm grade". */
  caption: string;
  /** Alt text describing what the final image will show. */
  alt: string;
  class?: string;
}
const { width, height, caption, alt, class: className = '' } = Astro.props;

const uid = `ph${Math.random().toString(36).slice(2, 8)}`;
const tile = Math.round(Math.max(width, height) / 7);
const c = tile / 2;
const R = tile / 2;
const inner = R * (Math.SQRT1_2 / Math.cos(Math.PI / 8));
const pts: string[] = [];
for (let i = 0; i < 16; i++) {
  const a = (i * Math.PI) / 8 - Math.PI / 2;
  const rad = i % 2 === 0 ? R : inner;
  pts.push(`${(c + rad * Math.cos(a)).toFixed(1)} ${(c + rad * Math.sin(a)).toFixed(1)}`);
}
const star = `M${pts.join('L')}Z`;
const gcd = (a: number, b: number): number => (b ? gcd(b, a % b) : a);
const g = gcd(width, height);
const ratio = `${width / g}:${height / g}`;
const pad = Math.round(Math.min(width, height) * 0.06);
const fs = Math.max(11, Math.round(Math.min(width, height) * 0.032));
---

<svg
  class:list={['placeholder-image block h-auto w-full', className]}
  width={width}
  height={height}
  viewBox={`0 0 ${width} ${height}`}
  role="img"
  aria-label={alt}
  data-placeholder="true"
>
  <defs>
    <pattern id={uid} width={tile} height={tile} patternUnits="userSpaceOnUse">
      <path d={star} fill="none" style="stroke: var(--color-gold)" stroke-width="1"></path>
    </pattern>
    <radialGradient id={`${uid}-v`} cx="50%" cy="45%" r="75%">
      <stop offset="0%" style="stop-color: var(--color-ink-700)"></stop>
      <stop offset="100%" style="stop-color: var(--color-ink)"></stop>
    </radialGradient>
  </defs>
  <rect width={width} height={height} fill={`url(#${uid}-v)`}></rect>
  <rect width={width} height={height} fill={`url(#${uid})`} opacity="0.14"></rect>
  <line
    x1={pad}
    x2={width - pad}
    y1={height - pad * 2.1}
    y2={height - pad * 2.1}
    style="stroke: var(--color-gold)"
    stroke-width="1"
    opacity="0.5"
  ></line>
  <text
    x={pad}
    y={height - pad * 1.2}
    style={`fill: var(--color-gold-soft); font-family: var(--font-sans); font-size: ${fs}px; letter-spacing: 0.14em; font-weight: 600;`}
  >
    {caption.toUpperCase()}
  </text>
  <text
    x={width - pad}
    y={height - pad * 1.2}
    text-anchor="end"
    style={`fill: var(--color-gold-soft); font-family: var(--font-sans); font-size: ${fs}px; letter-spacing: 0.14em; font-weight: 600; font-variant-numeric: tabular-nums;`}
  >
    {ratio}
  </text>
</svg>
