---
/**
 * 07 — FAQ teaser: four questions, answer first.
 *
 * Native <details>/<summary> (no JS), grouped with `name` so one opens at a time where
 * supported. The first answer is open on load. The marker is a fine plus whose vertical
 * stroke turns away as the answer opens.
 */
import { getEntry } from 'astro:content';
import SectionLabel from '@/components/ui/SectionLabel.astro';
import Button from '@/components/ui/Button.astro';

const home = await getEntry('home', 'home');
if (!home) throw new Error('src/content/home/home.yaml is required.');
const { faq } = home.data;
---

<section class="faq shell section-y" aria-labelledby="faq-title">
  <SectionLabel number="07">{faq.label}</SectionLabel>

  <div class="faq__grid">
    <div class="faq__intro">
      <h2 id="faq-title" class="faq__title" data-reveal="mask">
        {faq.heading}
      </h2>
      <Button href={faq.link.href} variant="text" class="faq__more">
        {faq.link.label}
      </Button>
    </div>

    <div class="faq__list" data-reveal="stagger">
      {faq.items.map((item, i) => (
        <details class="faq__item" name="home-faq" open={i === 0}>
          <summary class="faq__q">
            <span class="faq__num numerals" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <span class="faq__q-text">{item.q}</span>
            <span class="faq__mark" aria-hidden="true" />
          </summary>
          <div class="faq__a">
            <p>{item.a}</p>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  /* Layered so Tailwind utilities on the same element still win. */
  @layer components {
    .faq__grid {
      display: grid;
      gap: 3rem var(--gap-x);
      margin-top: clamp(3rem, 2rem + 4vw, 6rem);
    }
    @media (min-width: 1024px) {
      .faq__grid {
        grid-template-columns: repeat(12, minmax(0, 1fr));
        align-items: start;
      }
      .faq__intro {
        grid-column: 1 / span 4;
        position: sticky;
        top: calc(var(--header-h) + 2rem);
      }
      .faq__list {
        grid-column: 6 / span 7;
      }
    }
    .faq__title {
      font-size: var(--text-d2);
      line-height: var(--text-d2--line-height);
      letter-spacing: var(--text-d2--letter-spacing);
      font-weight: 340;
      font-variation-settings: 'opsz' 144;
      max-width: 12ch;
    }
    .faq__intro :global(.faq__more) {
      margin-top: 1.5rem;
    }

    .faq__list {
      border-top: 1px solid var(--color-ink);
    }
    .faq__item {
      border-bottom: 1px solid var(--color-line);
    }
    .faq__q {
      display: grid;
      grid-template-columns: 2.5rem minmax(0, 1fr) 1.5rem;
      gap: 0 1rem;
      align-items: baseline;
      padding-block: 1.5rem;
      cursor: pointer;
      list-style: none;
      font-family: var(--font-display);
      font-size: var(--text-d4);
      line-height: var(--text-d4--line-height);
      font-weight: 400;
      font-variation-settings: 'opsz' 36;
      transition: color 280ms var(--ease-quiet);
    }
    .faq__q::-webkit-details-marker {
      display: none;
    }
    .faq__q:hover {
      color: var(--color-royal);
    }
    .faq__num {
      font-family: var(--font-sans);
      font-size: var(--text-micro);
      letter-spacing: var(--text-micro--letter-spacing);
      font-weight: 650;
      color: var(--color-stone);
      translate: 0 -0.15em;
    }

    /* Plus → minus */
    .faq__mark {
      position: relative;
      align-self: center;
      width: 14px;
      height: 14px;
      justify-self: end;
    }
    .faq__mark::before,
    .faq__mark::after {
      content: '';
      position: absolute;
      inset: 50% 0 auto 0;
      height: 1px;
      background: var(--color-ink);
      transition: transform 480ms var(--ease-settle);
    }
    .faq__mark::after {
      transform: rotate(90deg);
    }
    .faq__item[open] .faq__mark::after {
      transform: rotate(0deg) scaleX(0);
    }

    .faq__a {
      padding: 0 0 1.75rem calc(2.5rem + 1rem);
      color: var(--color-stone);
      max-width: calc(60ch + 3.5rem);
    }
    .faq__item[open] .faq__a {
      animation: faq-open 520ms var(--ease-quiet);
    }
    @keyframes faq-open {
      from {
        opacity: 0;
      }
    }
    @media (max-width: 639.98px) {
      .faq__q {
        grid-template-columns: minmax(0, 1fr) 1.5rem;
      }
      .faq__num {
        display: none;
      }
      .faq__a {
        padding-inline-start: 0;
      }
    }
  }
</style>
