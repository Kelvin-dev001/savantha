---
/**
 * About · 04 How we are paid. The fee principles as a short numbered schedule, closed with
 * the double rule of a statement's total line (the same device as the homepage values).
 */
import type { CollectionEntry } from 'astro:content';
import SectionLabel from '@/components/ui/SectionLabel.astro';

interface Props {
  number: string;
  fees: CollectionEntry<'about'>['data']['fees'];
}
const { number, fees: f } = Astro.props;
const pad = (n: number) => String(n).padStart(2, '0');
---

<section class="fees shell section-y" aria-labelledby="fees-title">
  <SectionLabel number={number}>{f.label}</SectionLabel>

  <div class="fees__grid">
    <div class="fees__head">
      <h2 id="fees-title" class="fees__title" data-reveal="mask">
        {f.heading}
      </h2>
      <p class="fees__lead" data-reveal="fade">
        {f.lead}
      </p>
    </div>

    <div class="fees__body">
      <ol class="fees__list" data-reveal="stagger">
        {f.items.map((item, i) => (
          <li class="fees__item">
            <span class="fees__num numerals" aria-hidden="true">
              {pad(i + 1)}
            </span>
            <div>
              <h3 class="fees__item-title">{item.title}</h3>
              <p class="fees__detail">{item.detail}</p>
            </div>
          </li>
        ))}
      </ol>
      <div class="fees__total">
        <span class="fees__double" data-reveal="rule" aria-hidden="true"></span>
        <p class="fees__total-row">
          <span class="eyebrow fees__total-label">{f.total.label}</span>
          <span class="fees__total-text">{f.total.text}</span>
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  /* Layered so Tailwind utilities on the same element still win. */
  @layer components {
    .fees__grid {
      display: grid;
      gap: 3rem var(--gap-x);
      margin-top: clamp(3rem, 2rem + 4vw, 6rem);
    }
    @media (min-width: 1024px) {
      .fees__grid {
        grid-template-columns: repeat(12, minmax(0, 1fr));
        align-items: start;
      }
      .fees__head {
        grid-column: 1 / span 5;
      }
      .fees__body {
        grid-column: 7 / span 6;
      }
    }
    .fees__title {
      font-size: var(--text-d1);
      line-height: var(--text-d1--line-height);
      letter-spacing: var(--text-d1--letter-spacing);
      font-weight: 340;
      max-width: 13ch;
    }
    .fees__lead {
      margin-top: 1.5rem;
      color: var(--color-stone);
      max-width: 40ch;
    }
    .fees__list {
      border-top: 1px solid var(--color-ink);
    }
    .fees__item {
      display: grid;
      grid-template-columns: 2.75rem minmax(0, 1fr);
      gap: 0 1rem;
      padding-block: 1.375rem;
      border-bottom: 1px solid var(--color-line);
    }
    .fees__num {
      font-size: var(--text-micro);
      letter-spacing: var(--text-micro--letter-spacing);
      font-weight: 650;
      color: var(--color-stone);
      padding-top: 0.45rem;
    }
    .fees__item-title {
      font-size: var(--text-d4);
      line-height: var(--text-d4--line-height);
      font-weight: 420;
    }
    .fees__detail {
      margin-top: 0.375rem;
      color: var(--color-stone);
      font-size: var(--text-small);
      line-height: var(--text-small--line-height);
      max-width: 52ch;
    }
    .fees__total {
      position: relative;
      padding-top: 1.25rem;
    }
    .fees__double {
      position: absolute;
      inset: 0.25rem 0 auto 0;
      height: 4px;
      border-top: 1px solid var(--color-ink);
      border-bottom: 1px solid var(--color-ink);
      transform-origin: left;
    }
    .fees__total-row {
      display: grid;
      grid-template-columns: 5.5rem minmax(0, 1fr);
      align-items: baseline;
      padding-top: 0.5rem;
    }
    .fees__total-label {
      color: var(--color-stone);
    }
    .fees__total-text {
      font-family: var(--font-display);
      font-size: var(--text-d3);
      line-height: var(--text-d3--line-height);
      font-style: italic;
      font-weight: 340;
    }
  }
</style>
