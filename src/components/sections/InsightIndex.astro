---
/**
 * "Browse by subject": the category index in the Insights hero, ruled like the FAQ index.
 * Subjects with no guides yet are left out (their pages are not built). On a category page
 * the current subject is marked and "All subjects" leads back to the full list.
 */
import Icon from '@/components/ui/Icon.astro';
import type { Category, InsightsCopy } from '@/lib/insights';

interface Props {
  copy: InsightsCopy;
  categories: Category[];
  /** Total number of guides, for the "All subjects" row. */
  total: number;
  current?: Category['key'];
}
const { copy, categories, total, current } = Astro.props;

const count = (n: number) =>
  `${String(n).padStart(2, '0')} ${n === 1 ? copy.countLabel.one : copy.countLabel.many}`;
const rows = [
  { href: '/insights', title: copy.allLabel, n: total, isCurrent: !current },
  ...categories
    .filter((c) => c.count > 0)
    .map((c) => ({ href: c.href, title: c.title, n: c.count, isCurrent: c.key === current })),
];
---

<nav class="iidx" aria-labelledby="iidx-label">
  <h2 id="iidx-label" class="eyebrow iidx__label">
    {copy.indexLabel}
  </h2>
  <ol class="iidx__list">
    {rows.map((r) => (
      <li>
        <a href={r.href} class="iidx__link" aria-current={r.isCurrent ? 'page' : undefined}>
          <span class="iidx__name">{r.title}</span>
          <span class="iidx__count eyebrow numerals">{count(r.n)}</span>
          <Icon name="arrow-right" size={14} class="iidx__arrow" />
        </a>
      </li>
    ))}
  </ol>
</nav>

<style>
  /* Layered so Tailwind utilities on the same element still win. */
  @layer components {
    .iidx__label {
      color: var(--color-stone);
      padding-bottom: 1rem;
    }
    .iidx__list {
      border-top: 1px solid var(--color-ink);
    }
    .iidx__link {
      position: relative;
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto 1rem;
      gap: 0 0.75rem;
      align-items: baseline;
      min-height: 52px;
      padding-block: 0.875rem;
      border-bottom: 1px solid var(--color-line);
      transition: color 240ms var(--ease-quiet);
    }
    .iidx__link:hover {
      color: var(--color-royal);
    }
    .iidx__name {
      font-family: var(--font-display);
      font-size: 1.25rem;
      font-weight: 400;
    }
    .iidx__count {
      color: var(--color-stone);
    }
    .iidx__link :global(.iidx__arrow) {
      align-self: center;
      transition: transform 420ms var(--ease-settle);
    }
    .iidx__link:hover :global(.iidx__arrow) {
      transform: translateX(3px);
    }
    /* The subject you are on: italic, with a short gold rule in the margin */
    .iidx__link[aria-current='page'] .iidx__name {
      font-style: italic;
    }
    .iidx__link[aria-current='page']::before {
      content: '';
      position: absolute;
      left: -1.25rem;
      top: 50%;
      width: 0.75rem;
      height: 1px;
      background: var(--color-gold);
    }
    @media (max-width: 1023.98px) {
      .iidx__link[aria-current='page']::before {
        content: none;
      }
    }
  }
</style>
