---
/**
 * The enquiry form: three questions, like the clauses of a short letter of instruction.
 *
 *   01 What do you need?       one choice: the six services, or "Not sure yet"
 *   02 What is your goal?      one sentence, with a hint that follows the need chosen
 *   03 Where can we reach you? name, reply channel, and that one number or address
 *
 * With JavaScript: one question at a time, a ruled progress line that doubles as a way back,
 * inline errors, a JSON post to /api/contact and a "receipt" of what was sent. Without it:
 * all three questions in one form that posts normally (the endpoint redirects to
 * /contact/thank-you or /contact/not-sent). Copy: src/content/contact/contact.yaml.
 */
import { getEntry } from 'astro:content';
import { getPillars } from '@/lib/services';
import { whatsappLink } from '@/lib/contact';
import { FIELD, GOAL_MAX, GOAL_MIN, NAME_MAX } from '@/lib/enquiry-rules';
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import SectionLabel from '@/components/ui/SectionLabel.astro';

interface Props {
  number?: string;
}
const { number = '02' } = Astro.props;

const entry = await getEntry('contact', 'contact');
if (!entry) throw new Error('src/content/contact/contact.yaml is required.');
const f = entry.data.form;
const pillars = await getPillars();

const steps = [
  { key: 'need', ...f.questions.need },
  { key: 'goal', ...f.questions.goal },
  { key: 'reach', ...f.questions.reach },
] as const;
const channels = ['whatsapp', 'call', 'email'] as const;
const pad = (n: number) => String(n).padStart(2, '0');

/** Strings the script needs, in one JSON island. */
const client = {
  hints: f.goalHints,
  errors: f.errors,
  replyBy: f.fields.replyBy,
  success: f.success.body,
  sending: f.buttons.sending,
  submit: f.buttons.submit,
};
---

<section id="enquiry" class="enq" aria-labelledby="enq-title" data-enquiry>
  <SectionLabel number={number}>{f.label}</SectionLabel>

  <div class="enq__head">
    <h2 id="enq-title" class="enq__title" data-reveal="mask">
      {f.heading}
    </h2>
    <p class="enq__intro">{f.intro}</p>
  </div>

  <form class="enq__form" action="/api/contact" method="post" data-form data-step="0">
    <script type="application/json" data-copy set:html={JSON.stringify(client)} />
    <!-- Progress: three ruled cells. Answered steps become links back. -->
    <ol class="enq__progress" data-progress aria-label={f.progressLabel} hidden>
      {steps.map((s, i) => (
        <li class="enq__pcell" data-pcell={i}>
          <button type="button" class="enq__pbtn" data-goto={i} disabled>
            <span class="enq__pnum numerals">{pad(i + 1)}</span>
            <span class="enq__pname">{s.short}</span>
            <span class="sr-only" data-pstate />
          </button>
        </li>
      ))}
    </ol>

    <!-- Honeypot and fill-time trap -->
    <div class="enq__trap" aria-hidden="true">
      <label>
        Website
        <input type="text" name={FIELD.honeypot} tabindex="-1" autocomplete="off" />
      </label>
    </div>
    <input type="hidden" name={FIELD.started} value="" data-started />

    <!-- 01 What do you need? -->
    <fieldset class="enq__step" data-panel="0" aria-describedby="need-help">
      <legend class="enq__q" tabindex="-1" data-legend>
        <span class="enq__qnum numerals" aria-hidden="true">
          01
        </span>
        <span>{f.questions.need.question}</span>
      </legend>
      <p id="need-help" class="enq__help">
        {f.questions.need.help}
      </p>

      <div class="enq__needs">
        {pillars.map((p) => (
          <div
            class={`enq__group enq__group--${p.key}`}
            role="group"
            aria-labelledby={`need-p-${p.key}`}
          >
            <p id={`need-p-${p.key}`} class="enq__group-label eyebrow numerals">
              {p.numeral} <span aria-hidden="true">—</span> {p.title}
            </p>
            {p.services.map((s) => (
              <label class="enq__opt">
                <input type="radio" name={FIELD.need} value={s.slug} required class="enq__radio" />
                <span class="enq__tick" aria-hidden="true" />
                <span class="enq__opt-title">{s.title}</span>
              </label>
            ))}
          </div>
        ))}
        <div class="enq__group enq__group--unsure">
          <label class="enq__opt enq__opt--unsure">
            <input type="radio" name={FIELD.need} value="not-sure" class="enq__radio" />
            <span class="enq__tick" aria-hidden="true" />
            <span class="enq__opt-title">{f.notSure.title}</span>
            <span class="enq__opt-line">{f.notSure.line}</span>
          </label>
        </div>
      </div>
      <p class="enq__error" id="err-need" data-error="need" hidden />

      <div class="enq__nav" data-js-only hidden>
        <Button type="button" data-next icon="arrow-right">
          {f.buttons.next}
        </Button>
      </div>
    </fieldset>

    <!-- 02 What is your goal? -->
    <fieldset class="enq__step" data-panel="1" aria-describedby="goal-help">
      <legend class="enq__q" tabindex="-1" data-legend>
        <span class="enq__qnum numerals" aria-hidden="true">
          02
        </span>
        <span>{f.questions.goal.question}</span>
      </legend>
      <p id="goal-help" class="enq__help">
        {f.questions.goal.help}
      </p>

      <div class="enq__field">
        <label for="enq-goal" class="enq__label eyebrow">
          {f.fields.goal}
        </label>
        <textarea
          id="enq-goal"
          name={FIELD.goal}
          rows="4"
          required
          minlength={GOAL_MIN}
          maxlength={GOAL_MAX}
          placeholder={f.goalHints['not-sure']}
          aria-describedby="goal-help err-goal"
          class="enq__input enq__textarea"
          data-goal
        ></textarea>
        <p class="enq__error" id="err-goal" data-error="goal" hidden></p>
      </div>

      <div class="enq__nav" data-js-only hidden>
        <Button type="button" variant="text" icon="none" data-back>
          {f.buttons.back}
        </Button>
        <Button type="button" data-next icon="arrow-right">
          {f.buttons.next}
        </Button>
      </div>
    </fieldset>

    <!-- 03 Where can we reach you? -->
    <fieldset class="enq__step" data-panel="2" aria-describedby="reach-help">
      <legend class="enq__q" tabindex="-1" data-legend>
        <span class="enq__qnum numerals" aria-hidden="true">
          03
        </span>
        <span>{f.questions.reach.question}</span>
      </legend>
      <p id="reach-help" class="enq__help">
        {f.questions.reach.help}
      </p>

      <div class="enq__reach">
        <div class="enq__field">
          <label for="enq-name" class="enq__label eyebrow">
            {f.fields.name}
          </label>
          <input
            id="enq-name"
            name={FIELD.name}
            type="text"
            autocomplete="name"
            required
            maxlength={NAME_MAX}
            aria-describedby="err-name"
            class="enq__input"
          />
          <p class="enq__error" id="err-name" data-error="name" hidden></p>
        </div>

        <fieldset class="enq__field enq__channels">
          <legend class="enq__label eyebrow">{f.fields.channel}</legend>
          <div class="enq__seg">
            {channels.map((c, i) => (
              <label class="enq__segopt">
                <input type="radio" name={FIELD.channel} value={c} checked={i === 0} data-channel />
                <Icon
                  name={c === 'call' ? 'phone' : c === 'email' ? 'mail' : 'whatsapp'}
                  size={16}
                />
                <span>{f.fields.channels[c]}</span>
              </label>
            ))}
          </div>
        </fieldset>

        <div class="enq__field" data-for-channel="whatsapp call">
          <label for="enq-phone" class="enq__label eyebrow">
            {f.fields.phone}
          </label>
          <input
            id="enq-phone"
            name={FIELD.phone}
            type="tel"
            inputmode="tel"
            autocomplete="tel"
            aria-describedby="phone-hint err-phone"
            class="enq__input numerals"
          />
          <p id="phone-hint" class="enq__hint">
            {f.fields.phoneHint}
          </p>
          <p class="enq__error" id="err-phone" data-error="phone" hidden></p>
        </div>

        <div class="enq__field" data-for-channel="email">
          <label for="enq-email" class="enq__label eyebrow">
            {f.fields.email}
          </label>
          <input
            id="enq-email"
            name={FIELD.email}
            type="email"
            inputmode="email"
            autocomplete="email"
            aria-describedby="err-email"
            class="enq__input"
          />
          <p class="enq__error" id="err-email" data-error="email" hidden></p>
        </div>

        <div class="enq__consent">
          <label class="enq__check">
            <input type="checkbox" name={FIELD.consent} required aria-describedby="err-consent" />
            <span class="enq__box" aria-hidden="true">
              <Icon name="check" size={14} />
            </span>
            <span>
              {f.fields.consent}{' '}
              <a href={f.fields.consentLink.href} class="link">
                {f.fields.consentLink.label}
              </a>
              .
            </span>
          </label>
          <p class="enq__error" id="err-consent" data-error="consent" hidden></p>
        </div>
      </div>

      <div class="enq__nav enq__nav--submit">
        <Button type="button" variant="text" icon="none" data-back data-js-only hidden>
          {f.buttons.back}
        </Button>
        <Button type="submit" size="lg" icon="arrow-right" data-submit>
          {f.buttons.submit}
        </Button>
      </div>
    </fieldset>

    <div class="enq__alert" role="alert" data-alert hidden>
      <p data-alert-text></p>
      <a
        href={whatsappLink()}
        class="link"
        target="_blank"
        rel="noopener noreferrer"
        data-track="whatsapp_click"
        data-track-service="general"
        data-track-location="contact-form-error"
      >
        {f.errors.whatsappFallback}
        <span class="sr-only"> (opens in a new tab)</span>
      </a>
    </div>
  </form>

  <!-- Success: a receipt of what was sent -->
  <div class="enq__done" data-done hidden>
    <h3 class="enq__done-title" tabindex="-1" data-done-title>
      <Icon name="check" size={22} class="enq__done-icon" />
      <span data-done-heading>{f.success.heading}</span>
    </h3>
    <p class="enq__done-body" data-done-body></p>
    <div class="enq__receipt">
      <p class="eyebrow enq__receipt-label">{f.success.receiptLabel}</p>
      <dl class="enq__receipt-dl">
        {steps.map((s, i) => (
          <div class="enq__receipt-row">
            <dt>
              <span class="numerals">{pad(i + 1)}</span> {s.question}
            </dt>
            <dd data-receipt={s.key} />
          </div>
        ))}
      </dl>
    </div>
    <Button type="button" variant="text" icon="none" data-another>
      {f.buttons.another}
    </Button>
  </div>
</section>

<script>
  import { FIELD, GOAL_MAX, GOAL_MIN, isEmail, normalisePhone } from '@/lib/enquiry-rules';

  type Copy = {
    hints: Record<string, string>;
    errors: Record<string, string>;
    replyBy: Record<string, string>;
    success: string;
    sending: string;
    submit: string;
  };
  type Key = 'need' | 'goal' | 'name' | 'phone' | 'email' | 'consent';

  const track = (event: string, props: Record<string, string> = {}) =>
    window.dispatchEvent(new CustomEvent('savantho:track', { detail: { event, ...props } }));

  function init(root: HTMLElement) {
    const form = root.querySelector<HTMLFormElement>('[data-form]')!;
    const copy = JSON.parse(form.querySelector('[data-copy]')!.textContent!) as Copy;
    const panels = [...form.querySelectorAll<HTMLFieldSetElement>('[data-panel]')];
    const cells = [...form.querySelectorAll<HTMLElement>('[data-pcell]')];
    const goal = form.querySelector<HTMLTextAreaElement>('[data-goal]')!;
    const alert = form.querySelector<HTMLElement>('[data-alert]')!;
    const submit = form.querySelector<HTMLButtonElement>('[data-submit]')!;
    const done = root.querySelector<HTMLElement>('[data-done]')!;
    const el = (name: string) => form.elements.namedItem(name);
    const value = (name: string) => {
      const item = el(name);
      if (item instanceof RadioNodeList) return item.value;
      if (item instanceof HTMLInputElement && item.type === 'checkbox')
        return item.checked ? 'on' : '';
      return (item as HTMLInputElement | null)?.value.trim() ?? '';
    };

    let step = 0;
    let reached = 0;
    let stepOneTracked = false;

    // Enhance: one question at a time.
    root.dataset.enhanced = 'true';
    form.noValidate = true;
    form
      .querySelectorAll<HTMLElement>('[data-js-only], [data-progress]')
      .forEach((n) => (n.hidden = false));
    (form.querySelector('[data-started]') as HTMLInputElement).value = String(Date.now());

    // Preselect a need from ?service=slug (links from service pages).
    const pre = new URLSearchParams(location.search).get('service');
    if (pre) {
      const radio = form.querySelector<HTMLInputElement>(
        `input[name="${FIELD.need}"][value="${CSS.escape(pre)}"]`,
      );
      if (radio) radio.checked = true;
    }

    // ---------- errors ----------
    const errorEl = (k: Key) => form.querySelector<HTMLElement>(`[data-error="${k}"]`)!;
    const controls = (k: Key) => [
      ...form.querySelectorAll<HTMLInputElement>(`[name="${FIELD[k]}"]`),
    ];
    function setError(k: Key, message?: string) {
      const node = errorEl(k);
      node.textContent = message ?? '';
      node.hidden = !message;
      controls(k).forEach((c) => {
        if (message) c.setAttribute('aria-invalid', 'true');
        else c.removeAttribute('aria-invalid');
      });
      if (k === 'need') {
        const fs = panels[0];
        if (message) fs.setAttribute('aria-describedby', 'need-help err-need');
        else fs.setAttribute('aria-describedby', 'need-help');
      }
    }
    const channel = () => value(FIELD.channel) || 'whatsapp';

    function check(k: Key): string | undefined {
      const e = copy.errors;
      const v = value(FIELD[k]);
      switch (k) {
        case 'need':
          return v ? undefined : e.need;
        case 'goal':
          return v.length < GOAL_MIN ? e.goalShort : v.length > GOAL_MAX ? e.goalLong : undefined;
        case 'name':
          return v ? undefined : e.name;
        case 'phone':
          return channel() === 'email' || normalisePhone(v) ? undefined : e.phone;
        case 'email':
          return channel() !== 'email' || isEmail(v) ? undefined : e.email;
        case 'consent':
          return v ? undefined : e.consent;
      }
    }
    const stepKeys: Key[][] = [['need'], ['goal'], ['name', 'phone', 'email', 'consent']];

    /** Validate one step; focus the first problem. True when clean. */
    function validate(i: number): boolean {
      let first: Key | undefined;
      for (const k of stepKeys[i]) {
        const msg = check(k);
        setError(k, msg);
        if (msg && !first) first = k;
      }
      if (first) {
        const target = first === 'need' ? controls('need')[0] : controls(first)[0];
        target?.focus();
        return false;
      }
      return true;
    }

    // Clear an error as soon as the answer becomes valid.
    form.addEventListener('input', (ev) => {
      const t = ev.target as HTMLInputElement;
      const k = (Object.keys(FIELD) as (keyof typeof FIELD)[]).find((key) => FIELD[key] === t.name);
      if (!k || !(stepKeys.flat() as string[]).includes(k)) return;
      if (!errorEl(k as Key).hidden && !check(k as Key)) setError(k as Key);
    });

    // ---------- steps ----------
    function render(focus = true) {
      form.dataset.step = String(step);
      panels.forEach((p, i) => {
        p.hidden = i !== step;
      });
      cells.forEach((c, i) => {
        const btn = c.querySelector('button')!;
        const state = c.querySelector('[data-pstate]')!;
        c.dataset.state = i === step ? 'current' : i < reached || i < step ? 'done' : 'todo';
        btn.disabled = i > reached || i === step;
        if (i === step) btn.setAttribute('aria-current', 'step');
        else btn.removeAttribute('aria-current');
        state.textContent = i === step ? ' (current)' : i <= reached ? '' : ' (not yet)';
      });
      if (focus)
        panels[step].querySelector<HTMLElement>('[data-legend]')!.focus({ preventScroll: true });
      if (focus) {
        const top = form.getBoundingClientRect().top + window.scrollY - 120;
        if (window.scrollY > top) window.scrollTo({ top, behavior: 'smooth' });
      }
    }
    function go(i: number) {
      form.dataset.moved = 'true';
      step = Math.max(0, Math.min(2, i));
      reached = Math.max(reached, step);
      render();
    }

    form.addEventListener('click', (ev) => {
      const t = (ev.target as HTMLElement).closest<HTMLElement>(
        '[data-next], [data-back], [data-goto]',
      );
      if (!t) return;
      if (t.hasAttribute('data-back')) return go(step - 1);
      if (t.hasAttribute('data-goto')) {
        const target = Number(t.dataset.goto);
        // Moving forward through the rail still validates the steps in between.
        for (let i = step; i < target; i++) if (!validate(i)) return go(i);
        return go(target);
      }
      if (!validate(step)) return;
      if (step === 0 && !stepOneTracked) {
        stepOneTracked = true;
        track('form_step_1', { service: value(FIELD.need) });
      }
      go(step + 1);
    });

    // Enter in a single-line field advances instead of submitting early.
    form.addEventListener('keydown', (ev) => {
      if (ev.key !== 'Enter' || step === 2) return;
      const t = ev.target as HTMLElement;
      if (t instanceof HTMLInputElement && t.type === 'radio') {
        ev.preventDefault();
        form.querySelector<HTMLButtonElement>(`[data-panel="${step}"] [data-next]`)?.click();
      }
    });

    // The goal hint follows the need.
    const syncHint = () => {
      goal.placeholder = copy.hints[value(FIELD.need) || 'not-sure'] ?? copy.hints['not-sure'];
    };
    form.addEventListener('change', (ev) => {
      const t = ev.target as HTMLInputElement;
      if (t.name === FIELD.need) syncHint();
      if (t.name === FIELD.channel) syncChannel();
    });

    // Only the field for the chosen channel is shown.
    function syncChannel() {
      const c = channel();
      form.querySelectorAll<HTMLElement>('[data-for-channel]').forEach((n) => {
        const on = n.dataset.forChannel!.split(' ').includes(c);
        n.hidden = !on;
        n.querySelector('input')!.required = on;
      });
      setError('phone');
      setError('email');
    }

    // ---------- submit ----------
    form.addEventListener('submit', async (ev) => {
      ev.preventDefault();
      for (let i = 0; i < 3; i++)
        if (!validate(i)) return void (i !== step && (go(i), validate(i)));

      alert.hidden = true;
      submit.disabled = true;
      submit.setAttribute('aria-busy', 'true');
      const label = submit.querySelector('.btn__label')!;
      label.textContent = copy.sending;

      const data = Object.fromEntries(new FormData(form) as unknown as Iterable<[string, string]>);
      try {
        const res = await fetch(form.action, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(data),
        });
        const json = (await res.json()) as {
          ok: boolean;
          replyBy?: string;
          message?: string;
          errors?: Partial<Record<Key, string>>;
        };
        if (json.ok) return showDone(json.replyBy ?? copy.replyBy[channel()]);

        const errs = json.errors ?? {};
        const keys = Object.keys(errs) as Key[];
        if (keys.length) {
          const i = stepKeys.findIndex((ks) => ks.some((k) => keys.includes(k)));
          go(i);
          keys.forEach((k) => setError(k, errs[k]));
          controls(keys.find((k) => stepKeys[i].includes(k))!)[0]?.focus();
        } else showAlert(json.message ?? copy.errors.server);
      } catch {
        showAlert(copy.errors.server);
      } finally {
        submit.disabled = false;
        submit.removeAttribute('aria-busy');
        label.textContent = copy.submit;
      }
    });

    function showAlert(text: string) {
      alert.querySelector('[data-alert-text]')!.textContent = text;
      alert.hidden = false;
    }

    function showDone(replyBy: string) {
      track('form_submit', { service: value(FIELD.need), channel: channel() });
      const needInput = form.querySelector<HTMLInputElement>(
        `input[name="${FIELD.need}"]:checked`,
      )!;
      const needText = needInput.closest('label')!.querySelector('.enq__opt-title')!.textContent!;
      const reach = channel() === 'email' ? value(FIELD.email) : value(FIELD.phone);
      const channelText = form
        .querySelector<HTMLInputElement>(`input[name="${FIELD.channel}"]:checked`)!
        .closest('label')!
        .textContent!.trim();
      done.querySelector('[data-receipt="need"]')!.textContent = needText;
      done.querySelector('[data-receipt="goal"]')!.textContent = value(FIELD.goal);
      done.querySelector('[data-receipt="reach"]')!.textContent =
        `${value(FIELD.name)} · ${channelText}, ${reach}`;
      done.querySelector('[data-done-body]')!.textContent = copy.success.replace(
        '{replyBy}',
        replyBy,
      );
      form.hidden = true;
      done.hidden = false;
      done.querySelector<HTMLElement>('[data-done-title]')!.focus();
    }

    root.querySelector('[data-another]')!.addEventListener('click', () => {
      form.reset();
      (form.querySelector('[data-started]') as HTMLInputElement).value = String(Date.now());
      step = 0;
      reached = 0;
      done.hidden = true;
      form.hidden = false;
      syncHint();
      syncChannel();
      render();
    });

    syncHint();
    syncChannel();
    render(false);
  }

  document.querySelectorAll<HTMLElement>('[data-enquiry]').forEach(init);
</script>

<style>
  /* Layered so Tailwind utilities on the same element still win. */
  @layer components {
    .enq__head {
      margin-top: clamp(2rem, 1.5rem + 2vw, 3.5rem);
    }
    .enq__title {
      font-size: var(--text-d2);
      line-height: var(--text-d2--line-height);
      letter-spacing: var(--text-d2--letter-spacing);
      font-weight: 340;
      max-width: 18ch;
    }
    .enq__intro {
      margin-top: 1rem;
      color: var(--color-stone);
      max-width: 46ch;
    }

    .enq__form {
      margin-top: clamp(2rem, 1.5rem + 2vw, 3rem);
    }

    /* ---------- progress rail ---------- */
    .enq__progress {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      margin-bottom: clamp(2rem, 1.5rem + 2vw, 3rem);
    }
    .enq__pcell {
      position: relative;
      border-top: 1px solid var(--color-line);
    }
    .enq__pcell::before {
      content: '';
      position: absolute;
      inset: -1px 0 auto 0;
      height: 2px;
      background: var(--color-ink);
      transform: scaleX(0);
      transform-origin: left;
      transition: transform 620ms var(--ease-settle);
    }
    .enq__pcell[data-state='current']::before,
    .enq__pcell[data-state='done']::before {
      transform: scaleX(1);
    }
    .enq__pcell[data-state='done']::before {
      background: var(--color-gold);
    }
    .enq__pbtn {
      display: flex;
      align-items: baseline;
      gap: 0.625rem;
      width: 100%;
