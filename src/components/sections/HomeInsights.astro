---
/**
 * 06 — Insights: the three latest, set like a contents page.
 *
 * The newest piece leads with its cover; the next two follow as numbered entries. Articles
 * come from src/lib/insights.ts (published first, newest first, then drafts), the same
 * order as /insights. Drafts link to their review copy and read "In review" where a
 * published piece shows its date.
 */
import { getEntry } from 'astro:content';
import SectionLabel from '@/components/ui/SectionLabel.astro';
import Button from '@/components/ui/Button.astro';
import PlaceholderImage from '@/components/ui/PlaceholderImage.astro';
import Icon from '@/components/ui/Icon.astro';
import { formatDate, getInsights } from '@/lib/insights';

const home = await getEntry('home', 'home');
if (!home) throw new Error('src/content/home/home.yaml is required.');
const { insights: copy } = home.data;

const { insights } = await getInsights();
const latest = insights.slice(0, 3).map((a) => ({
  id: a.id,
  href: a.href,
  title: a.title,
  summary: a.summary,
  minutes: a.minutes,
  category: a.category.title,
  date: a.draft || !a.publishedAt ? copy.pending : formatDate(a.publishedAt),
  cover: a.entry.data.cover,
}));
const [lead, ...rest] = latest;
---

{lead && (
  <section class="ins surface-paper" aria-labelledby="ins-title">
    <div class="shell section-y">
      <SectionLabel number="06">{copy.label}</SectionLabel>

      <div class="ins__head">
        <h2 id="ins-title" class="ins__title" data-reveal="mask">
          {copy.heading}
        </h2>
        <div class="ins__aside">
          <p class="ins__lead" data-reveal="fade">
            {copy.lead}
          </p>
          <Button href={copy.link.href} variant="text">
            {copy.link.label}
          </Button>
        </div>
      </div>

      <div class="ins__grid">
        <article class="ins__feature" aria-labelledby={`ins-${lead.id}`}>
          <div class="ins__media">
            <div class="ins__media-inner" data-parallax="16">
              <PlaceholderImage
                width={1200}
                height={900}
                caption={lead.cover.caption}
                alt={lead.cover.alt}
              />
            </div>
          </div>
          <div class="ins__meta eyebrow">
            <span>{lead.category}</span>
            <span class="numerals">{lead.date}</span>
            <span class="numerals">{`${lead.minutes} ${copy.minutes}`}</span>
          </div>
          <h3 id={`ins-${lead.id}`} class="ins__feature-title">
            <a href={lead.href} class="ins__link">
              {lead.title}
            </a>
          </h3>
          <p class="ins__summary">{lead.summary}</p>
        </article>

        <ol class="ins__list" data-reveal="stagger">
          {rest.map((a, i) => (
            <li class="ins__item">
              <article aria-labelledby={`ins-${a.id}`}>
                <div class="ins__meta eyebrow">
                  <span class="numerals ins__index">{String(i + 2).padStart(2, '0')}</span>
                  <span>{a.category}</span>
                  <span class="numerals">{a.date}</span>
                </div>
                <h3 id={`ins-${a.id}`} class="ins__item-title">
                  <a href={a.href} class="ins__link">
                    {a.title}
                    <Icon name="arrow-right" size={16} class="ins__arrow" />
                  </a>
                </h3>
                <p class="ins__summary ins__summary--sm">{a.summary}</p>
              </article>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>
)}

<style>
  /* Layered so Tailwind utilities on the same element still win. */
  @layer components {
    .ins__head {
      display: grid;
      gap: 1.75rem var(--gap-x);
      margin-top: clamp(3rem, 2rem + 4vw, 6rem);
    }
    @media (min-width: 1024px) {
      .ins__head {
        grid-template-columns: repeat(12, minmax(0, 1fr));
        align-items: end;
      }
      .ins__title {
        grid-column: 1 / span 7;
      }
      .ins__aside {
        grid-column: 9 / span 4;
      }
    }
    .ins__title {
      font-size: var(--text-d1);
      line-height: var(--text-d1--line-height);
      letter-spacing: var(--text-d1--letter-spacing);
      font-weight: 340;
      font-variation-settings: 'opsz' 144;
      max-width: 12ch;
    }
    .ins__lead {
      color: var(--color-stone);
      max-width: 36ch;
      margin-bottom: 1rem;
    }

    .ins__grid {
      display: grid;
      gap: 3.5rem var(--gap-x);
      margin-top: clamp(3rem, 2rem + 3vw, 5rem);
    }
    @media (min-width: 1024px) {
      .ins__grid {
        grid-template-columns: repeat(12, minmax(0, 1fr));
        align-items: start;
      }
      .ins__feature {
        grid-column: 1 / span 7;
      }
      .ins__list {
        grid-column: 9 / span 4;
      }
    }

    .ins__media {
      overflow: hidden;
      border-radius: var(--radius-xs);
    }
    /* Slightly oversized so the parallax drift never shows an edge */
    .ins__media-inner {
      scale: 1.05;
    }
    .ins__meta {
      display: flex;
      flex-wrap: wrap;
      gap: 0.25rem 1.25rem;
      margin-top: 1.5rem;
      color: var(--color-stone);
    }
    .ins__feature-title {
      margin-top: 1rem;
      font-size: var(--text-d2);
      line-height: var(--text-d2--line-height);
      letter-spacing: var(--text-d2--letter-spacing);
      font-weight: 360;
      max-width: 22ch;
    }
    .ins__summary {
      margin-top: 1rem;
      color: var(--color-stone);
      max-width: 52ch;
    }
    .ins__summary--sm {
      font-size: var(--text-small);
    }

    .ins__list {
      border-top: 1px solid var(--color-ink);
    }
    .ins__item {
      padding-block: 1.75rem 2rem;
      border-bottom: 1px solid var(--color-line);
    }
    .ins__item .ins__meta {
      margin-top: 0;
    }
    .ins__index {
      color: var(--color-ink);
    }
    .ins__item-title {
      margin-top: 0.875rem;
      font-size: var(--text-d4);
      line-height: var(--text-d4--line-height);
      font-weight: 420;
    }

    .ins__link {
      text-decoration-line: underline;
      text-decoration-thickness: 1px;
      text-underline-offset: 0.2em;
      text-decoration-color: transparent;
      transition: text-decoration-color 280ms var(--ease-quiet);
    }
    .ins__link:hover {
      text-decoration-color: var(--color-gold);
    }
    .ins__link :global(.ins__arrow) {
      display: inline;
      margin-inline-start: 0.375rem;
      color: var(--color-gold);
      vertical-align: -0.1em;
    }
  }
</style>
