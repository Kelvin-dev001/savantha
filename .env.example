# Copy to .env and fill in. Never commit .env.
# On Vercel, set the same variables under Project → Settings → Environment Variables.

# Show dev-only outlines around [[PLACEHOLDER]] content. Set to "false" (or remove) for production.
PUBLIC_SHOW_PLACEHOLDERS=true

# Contact form (/api/contact → Resend). Read at runtime, never inlined into the build.
# Without RESEND_API_KEY the form refuses to send (503) and offers WhatsApp instead.
RESEND_API_KEY=
CONTACT_TO_EMAIL=info@savantho.net
# Sender must be on a domain verified in Resend.
CONTACT_FROM_EMAIL="Savantho website <website@savantho.net>"
# true = log enquiries to the server console instead of sending (local development, tests).
CONTACT_DRY_RUN=false
# Submissions allowed per IP address per 10 minutes.
CONTACT_RATE_LIMIT=5

# Analytics, behind a consent banner. Inlined at build time (set them on Vercel and redeploy).
# Leave PUBLIC_ANALYTICS_PROVIDER empty for no analytics at all: no banner, nothing loaded.
#   plausible: cookieless. PUBLIC_PLAUSIBLE_DOMAIN defaults to savantho.net; set
#              PUBLIC_PLAUSIBLE_SRC only for a proxied or self-hosted script.
#   ga4:       needs PUBLIC_GA4_ID (G-XXXXXXXXXX). Sets cookies; ads features are switched off.
# Name the provider in src/content/legal/privacy.md before switching it on.
PUBLIC_ANALYTICS_PROVIDER=
PUBLIC_PLAUSIBLE_DOMAIN=
PUBLIC_PLAUSIBLE_SRC=
PUBLIC_GA4_ID=
